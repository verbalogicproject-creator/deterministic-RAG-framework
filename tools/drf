#!/usr/bin/env python3
"""drf - Deterministic RAG Framework command line.

Subcommands are added as milestones land. M1.1 provides:

    drf build   --source SRC [--out PATH]     build an index
    drf verify  --index PATH [--compare PATH] check a manifest, or compare two
    drf inspect --index PATH                  show what an index contains

Every command prints the manifest `content_hash`, because that is the value
that makes two builds comparable.
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from drf.ingest.build import build_index          # noqa: E402
from drf.store import connect, read_manifest, table_count  # noqa: E402

DEFAULT_OUT = "index.db"


def cmd_build(args: argparse.Namespace) -> int:
    value, justification = build_index(
        source_path=args.source, out_path=args.out
    )
    content = value["content"]
    print(f"built  {args.out}")
    print(f"  content_hash  {value['content_hash']}")
    for key in ("nodes", "edges", "embeddings"):
        print(f"  {key:<13} {content['counts'][key]}")
    print(f"  collapsed     {content['counts']['collapsed_groups']} duplicate groups")
    print(f"  dropped       {content['counts']['dropped']}")
    for record in content["dropped"]:
        detail = record["detail"]
        print(f"    - {record['kind']}/{record['reason']}: "
              f"{detail.get('from', detail.get('node'))} -> {detail.get('to', '')}"
              f" [{detail.get('type', detail.get('model', ''))}]")
    if args.json:
        print(json.dumps(justification.to_dict(), indent=2))
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    from drf.hashing import sha256_value

    conn = connect(args.index)
    manifest = read_manifest(conn)
    recomputed = sha256_value(manifest["content"])
    stored = manifest["content_hash"]
    ok = recomputed == stored
    print(f"index    {args.index}")
    print(f"  stored      {stored}")
    print(f"  recomputed  {recomputed}")
    print(f"  intact      {'yes' if ok else 'NO - manifest has been altered'}")

    for table in ("nodes", "edges", "embeddings"):
        claimed = manifest["content"]["counts"][table]
        actual = table_count(conn, table)
        flag = "ok" if claimed == actual else "MISMATCH"
        print(f"  {table:<11} manifest={claimed} db={actual} {flag}")
        ok = ok and claimed == actual
    conn.close()

    if args.compare:
        other = connect(args.compare)
        other_manifest = read_manifest(other)
        other.close()
        same = other_manifest["content_hash"] == stored
        print(f"\ncompare  {args.compare}")
        print(f"  content_hash  {other_manifest['content_hash']}")
        print(f"  identical     {'yes' if same else 'NO'}")
        ok = ok and same

    return 0 if ok else 1


def cmd_query(args: argparse.Namespace) -> int:
    from drf.retrieval import merge as merge_module
    from drf.retrieval import neural, stage1
    from drf.retrieval.providers.null import NullProvider
    from drf.retrieval.providers.stored_vectors import StoredVectorProvider
    from drf.retrieval.tokenize import tokenize
    from drf.store import iter_nodes

    conn = connect(args.index)
    index_hash = read_manifest(conn)["content_hash"]
    terms = tokenize(args.text)

    ranked_rows, rank_just = stage1.rank(
        conn=conn, query_terms=terms, index_hash=index_hash,
        seed_count=args.seeds, max_depth=args.depth,
    )
    ranked = [stage1.Ranked(*row) for row in ranked_rows]
    deterministic = [r.node_id for r in ranked]

    provider = (
        StoredVectorProvider(conn) if args.neural == "stored" else NullProvider()
    )
    advisory, neural_just = neural.propose_from_anchors(
        provider=provider, anchors=deterministic[:5], limit=args.k,
        provider_name=provider.name, index_hash=index_hash,
    )
    merged = merge_module.merge(
        deterministic=deterministic,
        advisory=advisory,
        known_ids={n.id for n in iter_nodes(conn)},
    )

    names = {n.id: n.name for n in iter_nodes(conn)}
    detail = {r.node_id: r for r in ranked}
    print(f"query    {args.text!r}   terms={terms}")
    print(f"index    {index_hash[:16]}...  neural={args.neural}")
    print(f"{'#':>3s}  {'origin':<14s} {'bm25':>12s} {'trm':>4s} {'dep':>4s}  name")
    for result in merged[:args.k]:
        row = detail.get(result.node_id)
        if row is None:
            print(f"{result.rank:3d}  {result.origin:<14s} {'-':>12s} {'-':>4s} "
                  f"{'-':>4s}  {names.get(result.node_id, '?')[:52]}")
        else:
            depth = "-" if row.best_depth >= 1_000_000 else str(row.best_depth)
            print(f"{result.rank:3d}  {result.origin:<14s} {row.bm25_q:12d} "
                  f"{row.matched_terms:4d} {depth:>4s}  {names[row.node_id][:52]}")

    authoritative = sum(
        1 for r in merged if r.origin == merge_module.AUTHORITATIVE
    )
    print(f"\n{authoritative} authoritative, "
          f"{len(merged) - authoritative} advisory (appended below)")

    if args.explain:
        print()
        for justification in (rank_just, neural_just):
            data = justification.to_dict()
            print(f"  {data['action']:<28s} {data['determinism']:<14s} "
                  f"{data['authority']:<14s} {data['evidence']}")
    conn.close()
    return 0


def cmd_inspect(args: argparse.Namespace) -> int:
    conn = connect(args.index)
    manifest = read_manifest(conn)
    print(json.dumps(manifest, indent=2, ensure_ascii=False))
    conn.close()
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="drf", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("build", help="build an index from a source KG")
    p.add_argument("--source", required=True)
    p.add_argument("--out", default=DEFAULT_OUT)
    p.add_argument("--json", action="store_true", help="print the justification")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("verify", help="check an index against its manifest")
    p.add_argument("--index", default=DEFAULT_OUT)
    p.add_argument("--compare", help="a second index whose content_hash must match")
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("query", help="run a query through stage1 -> neural -> merge")
    p.add_argument("text")
    p.add_argument("--index", default=DEFAULT_OUT)
    p.add_argument("-k", type=int, default=10)
    p.add_argument("--neural", choices=("off", "stored"), default="off")
    p.add_argument("--seeds", type=int, default=10)
    p.add_argument("--depth", type=int, default=2)
    p.add_argument("--explain", action="store_true",
                   help="print the justification for each action")
    p.set_defaults(func=cmd_query)

    p = sub.add_parser("inspect", help="print an index manifest")
    p.add_argument("--index", default=DEFAULT_OUT)
    p.set_defaults(func=cmd_inspect)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
